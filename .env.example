# LubeLogger Instance Configuration

# Base URL of your self-hosted LubeLogger instance (e.g. http://192.168.1.100:5000 or https://lubelog.example.com)
LUBELOGGER_URL=http://localhost:5000

# API Key generated in LubeLogger web UI: Settings > API Keys (Editor or Manager role recommended)
LUBELOGGER_API_KEY=your_api_key_here

# Alternatively, if you use Basic Auth instead of API Keys:
# LUBELOGGER_USERNAME=admin
# LUBELOGGER_PASSWORD=password

# Set to false if connecting over HTTPS with a self-signed certificate
LUBELOGGER_VERIFY_SSL=true
